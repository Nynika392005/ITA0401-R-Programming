exam_data <- data.frame(
  name = c("Anu", "Ravi", "Priya", "Kiran", "Meena"),
  score = c(85, 45, 92, 60, 75),
  attempts = c(1, 3, 1, 2, 2),
  qualify = c(TRUE, FALSE, TRUE, TRUE, TRUE)
)

# Display data
print(exam_data)
str(exam_data)
summary(exam_data)

# Extract a column and selected rows
print(exam_data$name)
print(exam_data[1:3, ])
print(exam_data[exam_data$score >= 70, ])

# Add a new column
exam_data$grade <- ifelse(exam_data$score >= 80, "A", "B")
print(exam_data)

# Add a new row
new_row <- data.frame(
  name = "Arun",
  score = 68,
  attempts = 2,
  qualify = TRUE,
  grade = "B"
)

exam_data <- rbind(exam_data, new_row)
print(exam_data)

# Sort by score in descending order
sorted_data <- exam_data[order(-exam_data$score), ]
print(sorted_data)

# Save to CSV file
write.csv(exam_data, "exam_data.csv", row.names = FALSE)
